      "name": "Parse Leads CSV"
    },
    {
      "parameters": {
        "jsCode": "const cleanedItems = [];\n\nfor (const item of items) {\n  const data = item.json;\n\n  // Trim whitespace off every text field\n  for (const key in data) {\n    if (typeof data[key] === 'string') {\n      data[key] = data[key].trim();\n    }\n  }\n\n  // No name = unusable row, drop it\n  if (!data.name) continue;\n\n  const digits = (data.phone || '').replace(/\\D/g, '');\n  const reasons = [];\n\n  if (!digits) {\n    data.phone = '';\n    reasons.push('missing phone');\n  } else if (digits.startsWith('00977')) {\n    data.phone = '+977-' + digits.slice(5);\n  } else if (digits.startsWith('977') && digits.length >= 12) {\n    data.phone = '+977-' + digits.slice(3);\n  } else if (digits.startsWith('0')) {\n    data.phone = '+977-' + digits.slice(1);\n  } else if (digits.length === 10 && digits.startsWith('9')) {\n    data.phone = '+977-' + digits;\n  } else {\n    data.phone = digits;\n    reasons.push('phone format unclear');\n  }\n\n  data.needs_review = reasons.length > 0;\n  data.review_note = reasons.join(', ');\n\n  cleanedItems.push(item);\n}\n\nreturn cleanedItems;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
