    {
      "parameters": {
        "jsCode": "const lead = $('Process Each Lead').first().json;\n\nlet score = 0;\nif (String(lead.verified).toLowerCase() === 'true') score += 2;\nif (parseFloat(lead.rating) >= 4) score += 1;\nif (lead.phone) score += 1;\n\n// \"+9\" -> 9, \"2017\" -> 2017, \"\" -> null\nconst num = v => {\n  const cleaned = String(v ?? '').replace(/[^0-9.\\-]/g, '');\n  if (cleaned === '') return null;\n  const n = Number(cleaned);\n  return isNaN(n) ? null : n;\n};\n\nconst record = {\n  company_id: lead.company_id,\n  name: lead.name,\n  profile_url: lead.profile_url,\n  address: lead.address,\n  tagline: lead.tagline,\n  phone: lead.phone,\n  established_year: num(lead.established_year),\n  years_with_us: num(lead.years_with_us),\n  rating: num(lead.rating),\n  review_count: num(lead.review_count),\n  source_url: lead.source_url,\n  Score: score,\n  'Dedup Status': 'New',\n  'Needs Review': lead.needs_review === true,\n  'Review Note': lead.review_note,\n  'Date Added': new Date().toISOString(),\n};\n\nfor (const k in record) {\n  if (record[k] === null || record[k] === '' || record[k] === undefined) delete record[k];\n}\n\nreturn [{ json: record }];"
      },
